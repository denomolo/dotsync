# vars.yaml — template variables
#
# These are available in all .j2 templates. On a profile branch, edit this
# file to override them for that profile; base changes are merged in on sync.

hostname: my-machine
email: you@example.com
name: Your Name

# Editor
editor: nvim
default_shell: zsh

# Git
git_default_branch: main
git_sign_commits: false

# Theme (used by starship, alacritty etc.)
theme: catppuccin-mocha
