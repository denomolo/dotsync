# dotsync manifest
# Maps repo source files → system destinations.
#
# Source paths are relative to the repo root.
# Files ending in .j2 are rendered as Jinja2 templates using vars.yaml.
#
# Profiles are branches: to change a file or variable for one profile, edit
# it on that profile's branch. Changes on base are merged in on every sync.

files:
  # ── Shell ──────────────────────────────────────────────────────────────────
  - source: files/dot_zshrc.j2
    dest: ~/.zshrc

  - source: files/dot_bashrc.j2
    dest: ~/.bashrc

  # ── Git ────────────────────────────────────────────────────────────────────
  - source: files/dot_gitconfig.j2
    dest: ~/.gitconfig

  # ── Editors ────────────────────────────────────────────────────────────────
  - source: files/dot_vimrc
    dest: ~/.vimrc

  - source: files/nvim
    dest: ~/.config/nvim

  # ── Terminal ───────────────────────────────────────────────────────────────
  - source: files/dot_tmux.conf
    dest: ~/.tmux.conf

  - source: files/alacritty
    dest: ~/.config/alacritty

  # ── Desktop / WM ───────────────────────────────────────────────────────────
  - source: files/hypr
    dest: ~/.config/hypr

  - source: files/sway
    dest: ~/.config/sway

  # ── Tools ──────────────────────────────────────────────────────────────────
  - source: files/starship.toml.j2
    dest: ~/.config/starship.toml

  - source: files/thinkfan.yaml
    dest: ~/.config/thinkfan.yaml
